<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Oracle Log Sync Dashboard</title>
    <style>
        :root {
            --primary-color: #2c3e50;
            --secondary-color: #34495e;
            --accent-color: #3498db;
            --bg-color: #f4f6f9;
            --card-bg: #ffffff;
            --text-color: #2c3e50;
            --border-color: #e0e0e0;
            --success-color: #27ae60;
            --warning-color: #f39c12;
            --danger-color: #c0392b;
            --shadow: 0 4px 6px rgba(0,0,0,0.05);
            --radius: 8px;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 30px;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
        }

        h1 {
            color: var(--primary-color);
            margin-bottom: 25px;
            font-weight: 600;
        }

        /* KPI Cards */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .kpi-card {
            background: var(--card-bg);
            padding: 20px;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            border-left: 4px solid var(--accent-color);
            display: flex;
            flex-direction: column;
        }

        .kpi-label {
            font-size: 0.85em;
            color: #7f8c8d;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }

        .kpi-value {
            font-size: 2em;
            font-weight: 700;
            color: var(--primary-color);
        }

        /* Search & Filter */
        .top-controls {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            background: var(--card-bg);
            padding: 15px;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
        }

        .search-box {
            width: 300px;
            padding: 10px 15px;
            border: 1px solid var(--border-color);
            border-radius: 20px;
            outline: none;
            transition: border-color 0.3s;
        }

        .search-box:focus {
            border-color: var(--accent-color);
        }

        /* Table Styles */
        table {
            width: 100%;
            background: var(--card-bg);
            border-radius: var(--radius);
            border-collapse: separate;
            border-spacing: 0;
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        th {
            background-color: #f8f9fa;
            color: var(--secondary-color);
            font-weight: 600;
            text-align: left;
            padding: 15px 20px;
            border-bottom: 2px solid var(--border-color);
            border-right: 1px solid #eee;
            cursor: pointer;
            user-select: none;
        }

        th:last-child { border-right: none; }

        td {
            padding: 15px 20px;
            border-bottom: 1px solid #eee;
            vertical-align: top;
            border-right: 1px solid #f9f9f9;
        }

        tr:last-child td { border-bottom: none; }
        tr:hover td { background-color: #fafafa; }

        /* Component Styles */
        .host-link {
            font-weight: 600;
            color: var(--accent-color);
            text-decoration: none;
            font-size: 1.1em;
        }
        
        .instance-block {
            margin-bottom: 8px;
            padding-bottom: 8px;
            border-bottom: 1px dashed #eee;
        }
        .instance-block:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

        .instance-name {
            font-weight: 600;
            color: var(--text-color);
            text-decoration: none;
            display: inline-block;
            min-width: 80px;
        }

        /* Pills / Badges */
        .badge {
            display: inline-flex;
            align-items: center;
            padding: 2px 8px;
            border-radius: 12px;
            font-size: 0.8em;
            font-weight: 600;
            margin-left: 5px;
        }

        .badge-lag-ok { background-color: #e8f8f5; color: var(--success-color); }
        .badge-lag-warn { background-color: #fef9e7; color: var(--warning-color); }
        .badge-lag-err { background-color: #fdebd0; color: var(--danger-color); }
        
        .badge-size { background-color: #f4f6f7; color: #7f8c8d; }
        .badge-audit-ok { background-color: #e8f8f5; color: var(--success-color); }
        .badge-audit-err { background-color: #fdebd0; color: var(--danger-color); }

        .meta-text {
            color: #95a5a6;
            font-size: 0.85em;
            margin-left: 4px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Oracle Log Sync Dashboard</h1>

        {% set summary_path = local_report_dir ~ '/' ~ report_timestamp ~ '/log_sync_jobs/Daily_Execution_Summary.txt' %}
        {% set summary_content = lookup('file', summary_path, errors='ignore') %}

        <!-- KPI Cards Summary -->
        {% set lines = summary_content.splitlines() %}
        {% set host_count = lines | select('search', '|') | list | length %}
        
        <!-- Quick stats calculation (simplified logic for template) -->
        <div class="kpi-grid">
            <div class="kpi-card" style="border-left-color: var(--accent-color);">
                <span class="kpi-label">Total Hosts</span>
                <span class="kpi-value">{{ host_count }}</span>
            </div>
            <div class="kpi-card" style="border-left-color: var(--success-color);">
                <span class="kpi-label">Sync Status</span>
                <span class="kpi-value" style="font-size:1.2em; margin-top:5px;">Active</span>
            </div>
            <div class="kpi-card" style="border-left-color: var(--secondary-color);">
                <span class="kpi-label">Last Run</span>
                <span class="kpi-value" style="font-size:1.2em; margin-top:5px;">{{ report_timestamp }}</span>
            </div>
        </div>

        <div class="top-controls">
            <input type="text" id="searchInput" class="search-box" onkeyup="filterTable()" placeholder="Filter by Host or Instance...">
            <div style="font-size: 0.9em; color: #7f8c8d;">
                <span style="display:inline-block; width:10px; height:10px; background:var(--success-color); border-radius:50%; margin-right:5px;"></span>OK
                <span style="display:inline-block; width:10px; height:10px; background:var(--warning-color); border-radius:50%; margin:0 5px 0 15px;"></span>Warning (>1h)
                <span style="display:inline-block; width:10px; height:10px; background:var(--danger-color); border-radius:50%; margin:0 5px 0 15px;"></span>Critical (>24h)
            </div>
        </div>

        {% if summary_content %}
            <table id="statusTable">
                <thead>
                    <tr>
                        <th onclick="sortTable(0)" style="width: 15%;">Time / Host &#x2195;</th>
                        <th style="width: 30%;">Alert Logs (Size | Lag)</th>
                        <th style="width: 25%;">Audit Logs (File Count)</th>
                        <th style="width: 30%;">Listener Logs (Size | Lag)</th>
                    </tr>
                </thead>
                <tbody>
                {% set seen_hosts = [] %}
                {# Iterate in reverse to get the latest entry for each host first #}
                {% for line in summary_content.splitlines() | reverse %}
                    {% if '|' in line %}
                    {# Format: ISO-Time | HOST: hostname | INST: SID#Lag#Size#Audit,... | LSNR: LSNR#Lag#Size,... #}
                    {% set parts = line.split('|') %}
                    {% set time_str = parts[0] | trim %}
                    {% set time = time_str.split('T')[1].split('.')[0] %}
                    {% set host_part = parts[1].strip() %}
                    {% set host = host_part.split(':')[1].strip() %}

                    {# Unique Host Filter: Only show the first (latest) occurrence found #}
                    {% if host not in seen_hosts %}
                        {% set _ = seen_hosts.append(host) %}
                        
                        {% set inst_part = parts[2].strip() %}
                        {% set inst_list_str = inst_part.split(':')[1].strip() %}
                        {% if inst_list_str == '' %}{% set instances = [] %}{% else %}{% set instances = inst_list_str.split(',') %}{% endif %}

                        {% set lsnr_part = parts[3].strip() %}
                        {% set lsnr_list_str = lsnr_part.split(':')[1].strip() %}
                        {% if lsnr_list_str == '' %}{% set listeners = [] %}{% else %}{% set listeners = lsnr_list_str.split(',') %}{% endif %}

                        <tr>
                            <!-- Column 1: Time & Host -->
                            <td>
                                <div style="font-weight:600; color:#95a5a6; margin-bottom:4px;">{{ time }}</div>
                                <a href="../{{ host }}/log_sync_summary.txt" class="host-link">{{ host }}</a>
                            </td>

                            <!-- Column 2: Alert Logs (Instances) -->
                            <td>
                                {% if instances | length > 0 %}
                                    {% for i_str in instances %}
                                        {% if '#' in i_str %}
                                            {% set i_data = i_str.split('#') %}
                                            {% set sid = i_data[0] %}
                                            {% set lag = i_data[1] | int %}
                                            {% set size = i_data[2] | int %}
                                        {% else %}
                                            {% set sid = i_str %}
                                            {% set lag = 0 %}
                                            {% set size = 0 %}
                                        {% endif %}
                                        
                                        <div class="instance-block">
                                            <a href="{{ sid }}_job.html" class="instance-name">{{ sid }}</a>
                                            
                                            <!-- Size Badge (First) -->
                                            <span class="badge badge-size" title="Log Size">
                                                {{ (size/1024/1024)|round(1) }} MB
                                            </span>

                                            <!-- Lag Badge (Second) -->
                                            {% set lag_disp = 0 if lag < 0 else lag %}
                                            <span class="badge {{ 'badge-lag-err' if lag_disp > 86400 else 'badge-lag-warn' if lag_disp > 3600 else 'badge-lag-ok' }}">
                                                {% if lag_disp > 31536000 %}Missing{% elif lag_disp < 60 %}Synced{% else %}{{ (lag_disp/60)|round(0) }}m{% endif %}
                                            </span>
                                        </div>
                                    {% endfor %}
                                {% else %}
                                    <span class="meta-text">None</span>
                                {% endif %}
                            </td>

                            <!-- Column 3: Audit Logs (Instances) -->
                            <td>
                                {% if instances | length > 0 %}
                                    {% for i_str in instances %}
                                        {% if '#' in i_str %}
                                            {% set i_data = i_str.split('#') %}
                                            {% set sid = i_data[0] %}
                                            {% set audit = i_data[3] | int %}
                                        {% else %}
                                            {% set sid = i_str %}
                                            {% set audit = 0 %}
                                        {% endif %}

                                        <div class="instance-block">
                                            <span class="instance-name">{{ sid }}</span>
                                            <span class="badge {{ 'badge-audit-err' if audit > 50000 else 'badge-audit-ok' }}">
                                                {{ audit }} Files
                                            </span>
                                        </div>
                                    {% endfor %}
                                {% else %}
                                    <span class="meta-text">-</span>
                                {% endif %}
                            </td>

                            <!-- Column 4: Listener Logs -->
                            <td>
                                {% if listeners | length > 0 %}
                                    {% for l_str in listeners %}
                                        {% if '#' in l_str %}
                                            {% set l_data = l_str.split('#') %}
                                            {% set lsnr = l_data[0] %}
                                            {% set lag = l_data[1] | int %}
                                            {% set size = l_data[2] | int %}
                                        {% else %}
                                            {% set lsnr = l_str %}
                                            {% set lag = 0 %}
                                            {% set size = 0 %}
                                        {% endif %}

                                        <div class="instance-block">
                                            <a href="{{ lsnr }}_job.html" class="instance-name" style="color:var(--secondary-color);">{{ lsnr }}</a>
                                            
                                            <!-- Size Badge (First) -->
                                            <span class="badge badge-size">
                                                {{ (size/1024/1024)|round(1) }} MB
                                            </span>

                                            <!-- Lag Badge (Second) -->
                                            {% set lag_disp = 0 if lag < 0 else lag %}
                                            <span class="badge {{ 'badge-lag-err' if lag_disp > 86400 else 'badge-lag-warn' if lag_disp > 3600 else 'badge-lag-ok' }}">
                                                {% if lag_disp > 31536000 %}Missing{% elif lag_disp < 60 %}Synced{% else %}{{ (lag_disp/60)|round(0) }}m{% endif %}
                                            </span>
                                        </div>
                                    {% endfor %}
                                {% else %}
                                    <span class="meta-text">None</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endif %}
                    {% endif %}
                {% endfor %}
                </tbody>
            </table>
        {% else %}
            <div style="text-align:center; padding: 60px; color: #7f8c8d; background:white; border-radius:8px; box-shadow:var(--shadow);">
                <h2 style="margin:0;">No Data Available Yet</h2>
                <p style="margin-top:10px;">The daily execution summary file is empty or missing.</p>
            </div>
        {% endif %}

        <script>
        function filterTable() {
            var input, filter, table, tr, td, i, txtValue;
            input = document.getElementById("searchInput");
            filter = input.value.toUpperCase();
            table = document.getElementById("statusTable");
            tr = table.getElementsByTagName("tr");
            for (i = 0; i < tr.length; i++) {
                // Search in Host (col 0), Instance (col 1), or Listener (col 3)
                td0 = tr[i].getElementsByTagName("td")[0];
                td1 = tr[i].getElementsByTagName("td")[1];
                td3 = tr[i].getElementsByTagName("td")[3];
                
                if (td0 || td1 || td3) {
                    txtValue0 = td0.textContent || td0.innerText;
                    txtValue1 = td1.textContent || td1.innerText;
                    txtValue3 = td3.textContent || td3.innerText;
                    
                    if (txtValue0.toUpperCase().indexOf(filter) > -1 || 
                        txtValue1.toUpperCase().indexOf(filter) > -1 ||
                        txtValue3.toUpperCase().indexOf(filter) > -1) {
                        tr[i].style.display = "";
                    } else {
                        tr[i].style.display = "none";
                    }
                }
            }
        }

        function sortTable(n) {
            var table, rows, switching, i, x, y, shouldSwitch, dir, switchcount = 0;
            table = document.getElementById("statusTable");
            switching = true;
            dir = "asc"; 
            while (switching) {
                switching = false;
                rows = table.rows;
                for (i = 1; i < (rows.length - 1); i++) {
                    shouldSwitch = false;
                    x = rows[i].getElementsByTagName("TD")[n];
                    y = rows[i + 1].getElementsByTagName("TD")[n];
                    if (dir == "asc") {
                        if (x.innerHTML.toLowerCase() > y.innerHTML.toLowerCase()) {
                            shouldSwitch = true;
                            break;
                        }
                    } else if (dir == "desc") {
                        if (x.innerHTML.toLowerCase() < y.innerHTML.toLowerCase()) {
                            shouldSwitch = true;
                            break;
                        }
                    }
                }
                if (shouldSwitch) {
                    rows[i].parentNode.insertBefore(rows[i + 1], rows[i]);
                    switching = true;
                    switchcount ++;      
                } else {
                    if (switchcount == 0 && dir == "asc") {
                        dir = "desc";
                        switching = true;
                    }
                }
            }
        }
        </script>
    </div>
</body>
</html>
